{
  "whitelist": {
    "description": "解析白名单",
    "hint": "留空表示不限制",
    "type": "list",
    "default": []
  },
  "blacklist": {
    "description": "解析黑名单",
    "hint": "可在会话中使用开启解析/关闭解析命令",
    "type": "list",
    "default": []
  },
  "arbiter": {
    "description": "群聊解析仲裁",
    "hint": "多个 Bot 同时收到链接时只允许一个解析",
    "type": "bool",
    "default": true
  },
  "require_at_in_group": {
    "description": "群组消息必须 @ 机器人",
    "type": "bool",
    "default": true
  },
  "debounce_interval": {
    "description": "防抖秒数",
    "type": "int",
    "slider": {"min": 0, "max": 600, "step": 10},
    "default": 300
  },
  "source_max_size": {
    "description": "资源最大大小（MB）",
    "type": "int",
    "slider": {"min": 10, "max": 500, "step": 10},
    "default": 90
  },
  "source_max_minute": {
    "description": "资源最大时长（分钟）",
    "type": "int",
    "slider": {"min": 1, "max": 60, "step": 1},
    "default": 15
  },
  "audio_to_file": {
    "description": "音频以文件形式发送",
    "type": "bool",
    "default": true
  },
  "single_heavy_render_card": {
    "description": "（已废弃）单条重媒体渲染卡片",
    "hint": "信息卡片总开关开启时，所有解析结果都会发送一张信息卡片；此项仅保留用于兼容旧配置。",
    "type": "bool",
    "default": false,
    "invisible": true
  },
  "forward_threshold": {
    "description": "合并转发阈值",
    "type": "int",
    "slider": {"min": 0, "max": 10, "step": 1},
    "default": 2
  },
  "card_enabled": {
    "description": "渲染并发送信息卡片",
    "hint": "关闭后不生成 HTML/PNG，也不发送卡片；原媒体发送流程不受影响",
    "type": "bool",
    "default": true
  },
  "card_template": {
    "description": "卡片模板",
    "hint": "可在插件 templates 目录或数据目录 templates 中添加同名 HTML 模板",
    "type": "string",
    "options": ["default", "compact", "apple", "custom"],
    "labels": ["标准卡片", "紧凑卡片", "Apple 风格卡片", "自定义模板"],
    "default": "apple"
  },
  "card_custom_template": {
    "description": "自定义卡片模板文件名",
    "hint": "当卡片模板选择“自定义模板”时填写，例如 my_card；模板放在插件数据目录 templates 中",
    "type": "string",
    "default": ""
  },
  "card_dynamic_color": {
    "description": "Apple 卡片动态取色",
    "hint": "开启后 Apple 风格卡片会根据首张预览图生成柔和底色；预览图不可用时自动回退默认白底",
    "type": "bool",
    "default": false
  },
  "emoji_style": {
    "description": "表情样式",
    "hint": "APPLE 使用 Apple 风格资源；没有本地资源时回退为系统字体",
    "type": "string",
    "options": ["APPLE", "FACEBOOK", "GOOGLE", "TWITTER"],
    "labels": ["Apple", "Facebook", "Google", "Twitter"],
    "default": "APPLE"
  },
  "show_download_fail_tip": {
    "description": "下载失败时发送占位提示",
    "hint": "图片和视频会发送 error_media.png；关闭后不发送下载失败提示",
    "type": "bool",
    "default": true
  },
  "download_timeout": {
    "description": "下载请求超时秒数",
    "type": "int",
    "slider": {"min": 10, "max": 600, "step": 10},
    "default": 280
  },
  "download_retry_times": {
    "description": "下载失败重试次数",
    "type": "int",
    "slider": {"min": 0, "max": 5, "step": 1},
    "default": 2
  },
  "common_timeout": {
    "description": "普通请求超时秒数",
    "type": "int",
    "slider": {"min": 5, "max": 60, "step": 1},
    "default": 15
  },
  "proxy": {
    "description": "代理地址",
    "hint": "例如 http://127.0.0.1:7890，留空直连",
    "type": "string",
    "default": ""
  },
  "clean_cron": {
    "description": "自动清理缓存的 Cron",
    "type": "string",
    "default": "30 2 * * *"
  },
  "parsers_template": {
    "description": "解析器",
    "type": "template_list",
    "hint": "仅保留 Bilibili、抖音、小红书、Pixiv；未配置的解析器不会启用",
    "templates": {
      "bilibili": {
        "name": "Bilibili 解析器",
        "items": {
          "enable": {"description": "启用", "type": "bool", "default": true},
          "use_proxy": {"description": "使用代理", "type": "bool", "default": false},
          "cookies": {"description": "Cookies", "type": "text", "default": ""},
          "video_codec_list": {
            "description": "视频编码优先级",
            "type": "list",
            "options": ["AVC", "AV1", "HEV"],
            "default": ["AVC", "AV1", "HEV"]
          },
          "video_quality": {
            "description": "视频画质",
            "type": "string",
            "options": ["_360P", "_480P", "_720P", "_1080P", "_4K", "HDR", "DOLBY", "_8K"],
            "default": "_720P"
          }
        }
      },
      "douyin": {
        "name": "抖音解析器",
        "items": {
          "enable": {"description": "启用", "type": "bool", "default": true},
          "use_proxy": {"description": "使用全局 HTTP 代理", "type": "bool", "default": false},
          "worker_proxy_enabled": {
            "description": "启用抖音专用代理",
            "hint": "仅在同时填写代理地址时生效，只影响抖音解析与媒体下载",
            "type": "bool",
            "default": false
          },
          "worker_proxy_url": {
            "description": "抖音专用代理地址",
            "hint": "填写已部署 cloudflare_worker_v2.js 的 Worker 根地址，例如 https://example.workers.dev；请仅使用可信部署",
            "type": "string",
            "default": ""
          },
          "cookies": {"description": "Cookies", "type": "text", "default": ""}
        }
      },
      "xhs": {
        "name": "小红书解析器",
        "items": {
          "enable": {"description": "启用", "type": "bool", "default": true},
          "use_proxy": {"description": "使用代理", "type": "bool", "default": false},
          "cookies": {"description": "Cookies", "type": "text", "default": ""}
        }
      },
      "pixiv": {
        "name": "Pixiv 解析器",
        "items": {
          "enable": {"description": "启用", "type": "bool", "default": false},
          "use_proxy": {"description": "使用代理", "type": "bool", "default": false},
          "cookies": {"description": "Cookies", "type": "text", "default": ""},
          "nsfw": {
            "description": "R18 内容处理",
            "type": "string",
            "options": ["send", "blur", "ignore"],
            "labels": ["正常发送", "封面模糊", "忽略"],
            "default": "send"
          },
          "multi_image_forward": {
            "description": "多图使用合并转发",
            "hint": "仅对普通插画多图作品生效；关闭时在单条消息中发送多张图片",
            "type": "bool",
            "default": false
          },
          "max_page": {"description": "漫画最大页数", "type": "int", "default": 0}
        }
      }
    }
  }
}
